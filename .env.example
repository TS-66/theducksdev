# Ducky AI | Coder — environment variables (all optional)
#
# Bring-your-own-model: every user adds THEIR OWN base URL + API key + model
# in Settings → Connections (stored in their browser only). These server
# variables are just a SHARED FALLBACK so a deployment works with zero
# per-user setup. Server keys never reach the browser (.env* is gitignored).
# Easiest path: run `ducky setup` on the server (live-tested before saving).

# OpenAI-compatible chat-completions base URL
# (e.g. https://api.example.com/v1 — the proxy appends /chat/completions)
AI_BASE_URL=

# Bearer key for the endpoint above — SERVER ONLY, never in UI/git
AI_API_KEY=

# Model id served by the endpoint above
AI_MODEL_ID=

# --- Your own database (everything in one place, live rotation, no restart) ---
# Have your database write this JSON file; the server re-reads it per request,
# so key rotations apply instantly. Field priority per key: env var > this file.
# DUCKY_SECRETS_FILE=/run/ducky/secrets.json
# {"apiKey":"...","model":"...","baseUrl":"https://..."}
