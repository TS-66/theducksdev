{
  "name": "@ducky/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for ducky",
  "bin": {
    "ducky": "./dist/zcode.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/zcode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/ducky-cli run build --filter=!@ducky/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@ducky/adapters": "workspace:*",
    "@ducky/bootstrap": "workspace:*",
    "@ducky/contracts": "workspace:*",
    "@ducky/core": "workspace:*",
    "@ducky/dynamic-workflow-runtime": "workspace:*",
    "@ducky/i18n": "workspace:*",
    "@ducky/provider-node": "workspace:*",
    "@ducky/shared": "workspace:*",
    "@ducky/shared-types": "workspace:*",
    "@ducky/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
