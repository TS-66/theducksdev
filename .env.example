# Ducky AI | Coder — environment variables (all optional)
#
# Without these the app runs the zero-config scripted demo engine.
# Copy to `.env.local` for local dev, or set them in your hosting dashboard.

# OpenAI-compatible chat-completions base URL
AI_BASE_URL=

# Bearer key for the endpoint above
AI_API_KEY=

# Upstream model id that powers Ducky 3.5 Coder
# (defaults to passing the public id through to the endpoint)
AI_MODEL_ID=
