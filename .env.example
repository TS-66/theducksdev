# Ducky AI | Coder — environment variables (all optional)
#
# ONE provider: NVIDIA Build serving Nemotron 3 Ultra (frontier reasoning +
# agentic coding, tool calling, streaming thinking, up to 1M context).
# The model key lives ONLY here on the server (.env.local, hosting dashboard,
# shell env, or the JSON file below). It is never sent to browsers, never
# committed (.env* is gitignored), and /api/config exposes booleans + a
# label only.
# Easiest path: run `ducky setup` on the server and paste one free key —
# users then just chat.

# --- The one provider: NVIDIA Build (free credits, no card) ---
# 1. Open build.nvidia.com → sign in → open "nemotron-3-ultra-550b-a55b" → "Get API Key" (nvapi-...)
# 2. Run: ducky setup   (hidden input, OS keychain first, locked file fallback)
# Or set manually:
AI_PROVIDER=nvidia

# Upstream model id that powers Ducky 3.5 Coder
# (preset default: nvidia/nemotron-3-ultra-550b-a55b — set only to override)
AI_MODEL_ID=

# Bearer key for the endpoint — SERVER ONLY, never in UI/git
AI_API_KEY=

# OpenAI-compatible chat-completions base URL
# (preset default already set — configure only for a custom endpoint)
AI_BASE_URL=

# --- Your own database (everything in one place, live rotation, no restart) ---
# Have your database write this JSON file; the server re-reads it per request,
# so key rotations apply instantly. Field priority per key: env var > this file.
# DUCKY_SECRETS_FILE=/run/ducky/secrets.json
# {"apiKey":"nvapi-...","model":"nvidia/nemotron-3-ultra-550b-a55b","baseUrl":"https://..."}
